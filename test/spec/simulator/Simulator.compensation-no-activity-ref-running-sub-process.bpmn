        <bpmn:messageEventDefinition id="MessageEventDefinition_WAIT" messageRef="Message_WAIT"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="S_END" name="S_END">
        <bpmn:incoming>Flow_S3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="S_START" targetRef="A"/>
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="A" targetRef="WAIT"/>
      <bpmn:sequenceFlow id="Flow_S3" sourceRef="WAIT" targetRef="S_END"/>
