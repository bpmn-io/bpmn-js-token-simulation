      <bpmn:sequenceFlow id="Flow_S_START_A" sourceRef="S_START" targetRef="A"/>
      <bpmn:sequenceFlow id="Flow_A_S_END" sourceRef="A" targetRef="S_END"/>
    </bpmn:subProcess>
    <bpmn:intermediateThrowEvent id="COMP_S" name="COMP_S">
