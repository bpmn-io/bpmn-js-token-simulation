      <bpmn:outgoing>Flow_COMP_S_WAIT</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_S" activityRef="S"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="WAIT" name="WAIT">
      <bpmn:incoming>Flow_COMP_S_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_WAIT_END</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_WAIT" messageRef="Message_WAIT"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="END" name="END">
      <bpmn:incoming>Flow_WAIT_END</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="EVENT_SUB" name="EVENT_SUB" triggeredByEvent="true">
      <bpmn:startEvent id="EVENT_SUB_START" name="EVENT_SUB_START" isInterrupting="false">
        <bpmn:outgoing>Flow_EVENT_SUB_START_EVENT_SUB_END</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_NOTE" messageRef="Message_NOTE"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="EVENT_SUB_END" name="EVENT_SUB_END">
        <bpmn:incoming>Flow_EVENT_SUB_START_EVENT_SUB_END</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_EVENT_SUB_START_EVENT_SUB_END" sourceRef="EVENT_SUB_START" targetRef="EVENT_SUB_END"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_START_S" sourceRef="START" targetRef="S"/>
    <bpmn:sequenceFlow id="Flow_S_COMP_S" sourceRef="S" targetRef="COMP_S"/>
    <bpmn:sequenceFlow id="Flow_COMP_S_WAIT" sourceRef="COMP_S" targetRef="WAIT"/>
    <bpmn:sequenceFlow id="Flow_WAIT_END" sourceRef="WAIT" targetRef="END"/>
  </bpmn:process>
