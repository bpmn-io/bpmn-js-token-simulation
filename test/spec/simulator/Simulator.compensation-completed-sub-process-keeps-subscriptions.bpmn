      </bpmn:task>
      <bpmn:boundaryEvent id="A_COMP_BOUNDARY" name="A_COMP_BOUNDARY" attachedToRef="A">
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_A"/>
      </bpmn:boundaryEvent>
      <bpmn:task id="UNDO_A" name="UNDO_A" isForCompensation="true"/>
      <bpmn:association id="Association_A" associationDirection="One" sourceRef="A_COMP_BOUNDARY" targetRef="UNDO_A"/>
      <bpmn:endEvent id="S_END" name="S_END">
        <bpmn:incoming>Flow_A_S_END</bpmn:incoming>
