    <bpmn:sequenceFlow id="Flow_2" sourceRef="FORK" targetRef="S"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="FORK" targetRef="S"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="S" targetRef="WAIT"/>
