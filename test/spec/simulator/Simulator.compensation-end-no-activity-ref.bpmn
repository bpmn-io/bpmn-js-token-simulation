    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_START_A" sourceRef="START" targetRef="A"/>
    <bpmn:sequenceFlow id="Flow_A_B" sourceRef="A" targetRef="B"/>
    <bpmn:sequenceFlow id="Flow_B_COMP_END" sourceRef="B" targetRef="COMP_END"/>
