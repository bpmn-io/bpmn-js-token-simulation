<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="START" name="START">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A" name="A">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="A_COMP_BOUNDARY" name="A_COMP_BOUNDARY" attachedToRef="A">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_A"/>
    </bpmn:boundaryEvent>
    <bpmn:task id="COMPENSATE_A" name="COMPENSATE_A" isForCompensation="true"/>
    <bpmn:intermediateCatchEvent id="WAIT" name="WAIT">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_WAIT" messageRef="Message_WAIT"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="END" name="END">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="EVENT_SUB" name="EVENT_SUB" triggeredByEvent="true">
      <bpmn:startEvent id="EVENT_SUB_START" name="EVENT_SUB_START">
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_CANCEL" messageRef="Message_CANCEL"/>
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="COMP_ALL" name="COMP_ALL">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_ALL"/>
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="EVENT_SUB_END" name="EVENT_SUB_END">
        <bpmn:incoming>Flow_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="EVENT_SUB_START" targetRef="COMP_ALL"/>
      <bpmn:sequenceFlow id="Flow_6" sourceRef="COMP_ALL" targetRef="EVENT_SUB_END"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="START" targetRef="A"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="A" targetRef="WAIT"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="WAIT" targetRef="END"/>
    <bpmn:association id="Association_A" associationDirection="One" sourceRef="A_COMP_BOUNDARY" targetRef="COMPENSATE_A"/>
  </bpmn:process>
  <bpmn:message id="Message_WAIT" name="WAIT"/>
  <bpmn:message id="Message_CANCEL" name="CANCEL"/>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="START_di" bpmnElement="START">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="COMPENSATE_A_di" bpmnElement="COMPENSATE_A">
        <dc:Bounds x="330" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WAIT_di" bpmnElement="WAIT">
        <dc:Bounds x="402" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="END_di" bpmnElement="END">
        <dc:Bounds x="492" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_COMP_BOUNDARY_di" bpmnElement="A_COMP_BOUNDARY">
        <dc:Bounds x="272" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="180" y="182" width="104" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EVENT_SUB_di" bpmnElement="EVENT_SUB" isExpanded="true">
        <dc:Bounds x="150" y="320" width="300" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EVENT_SUB_START_di" bpmnElement="EVENT_SUB_START">
        <dc:Bounds x="182" y="362" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="COMP_ALL_di" bpmnElement="COMP_ALL">
        <dc:Bounds x="282" y="362" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EVENT_SUB_END_di" bpmnElement="EVENT_SUB_END">
        <dc:Bounds x="382" y="362" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="402" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="438" y="120"/>
        <di:waypoint x="492" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="218" y="380"/>
        <di:waypoint x="282" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="318" y="380"/>
        <di:waypoint x="382" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_A_di" bpmnElement="Association_A">
        <di:waypoint x="290" y="178"/>
        <di:waypoint x="290" y="240"/>
        <di:waypoint x="330" y="240"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
