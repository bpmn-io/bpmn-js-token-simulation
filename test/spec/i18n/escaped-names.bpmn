      <bpmn:sequenceFlow id="Flow_3" sourceRef="Order_Start" targetRef="Order_Receive" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Order_Receive" targetRef="Order_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="END">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="START" targetRef="Order" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Order" targetRef="END" />
  </bpmn:process>
